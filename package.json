{
  "name": "@kauaamaropires/ytdl-playlist",
  "version": "4.0.0",
  "description": "CLI and Node.js library for downloading YouTube videos and playlists as MP3 or MP4.",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "scripts": {
    "test": "node --test",
    "test:syntax": "node --check src/cli.js && node --check src/index.js && node --check scripts/release.js",
    "prepack": "npm test && npm run test:syntax",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KauaAmaroPires/Download_Youtube.git"
  },
  "bin": {
    "ytdlpl": "./src/cli.js"
  },
  "keywords": [
    "playlists",
    "download",
    "videos",
    "youtube-downloader",
    "download-videos",
    "ytdl-core",
    "cli"
  ],
  "author": "Kauã Amaro Pires",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "figlet": "^1.9.3",
    "inquirer": "^8.2.7",
    "youtube-dl-exec": "^3.1.17"
  }
}
